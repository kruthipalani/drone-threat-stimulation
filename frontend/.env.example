# THRYVE | Drone Threat Simulation Trainer - Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Database direct connection string for migrations/seed scripts
DATABASE_URL=postgresql://postgres:your-password@db.your-supabase-project-id.supabase.co:5432/postgres
